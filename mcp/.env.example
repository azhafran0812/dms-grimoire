# LLM Configuration (local or remote OpenAI-compatible endpoint)
LLM_ENDPOINT=http://127.0.0.1:7788/v1/chat/completions
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-5.6-luna
LLM_TIMEOUT_MS=30000

# Server
PORT=3000
NODE_ENV=development

# Growtopia Set Planner Render
GT_RENDER_ENDPOINT=https://gtsetplanner.com/generate
GT_ITEMS_URL=https://gtsetplanner.com/static/spfe_encrypted.json

# Database / Cache
XOR_KEY=sorenessiscool
CACHE_PATH=./data/items_cache.json
