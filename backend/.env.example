# ═══════════════════════════════════════════════
# DM's Grimoire — Game Backend Environment Config
# ═══════════════════════════════════════════════

# Server
PORT=4000
NODE_ENV=development

# Firebase Client SDK Credentials
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebasedatabase.app
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# MCP Server (Third-Party AI Service)
MCP_BASE_URL=http://localhost:3000

# Frontend Origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173